# SF32LB52 黄山派 VelaWear + Vela AI Agent 配置片段
# Apply/review in vendor/sifli/boards/sf32lb52/lckfb_huangshan_pi/configs/nsh/defconfig.
# This file is documentation of the required board overlay; it is not auto-applied.

CONFIG_LVX_USE_DEMO_CONTEST2026_329_VELAWEAR_AGENT=y
CONFIG_EXAMPLES_AI_AGENT_VELA=y
CONFIG_EXAMPLES_AI_AGENT_VELA_PROGNAME="ai_agent"
CONFIG_EXAMPLES_AI_AGENT_VELA_PRIORITY=100
CONFIG_EXAMPLES_AI_AGENT_VELA_STACKSIZE=32768
CONFIG_EXAMPLES_AI_AGENT_VELA_DATA_DIR="/data/agent"
CONFIG_EXAMPLES_AI_AGENT_VELA_SHELL_ALLOWLIST=y

# Required by the official Agent network manager shell bridge.
CONFIG_SYSTEM_SYSTEM=y
CONFIG_SYSTEM_POPEN=y

# Optional Agent channels remain disabled until their board paths are verified.
# CONFIG_AI_AGENT_FEISHU is not set
# CONFIG_AI_AGENT_WEIXIN is not set
# CONFIG_AI_AGENT_MQTT is not set
# CONFIG_AI_AGENT_NODE is not set
# CONFIG_AI_AGENT_MCP is not set
# CONFIG_AI_AGENT_LVGL_UI is not set
# CONFIG_AI_AGENT_BLE_GATT is not set
# CONFIG_AI_AGENT_BLE_NET is not set
# CONFIG_AI_AGENT_REST_API is not set
# CONFIG_AI_AGENT_CAMERA is not set
# CONFIG_AI_AGENT_AUDIO_PREPROCESS is not set
# CONFIG_AI_AGENT_AUDIO_ALSA_DIRECT is not set
# CONFIG_AI_AGENT_SKILL_SYNC is not set
# CONFIG_AI_AGENT_TEST is not set
